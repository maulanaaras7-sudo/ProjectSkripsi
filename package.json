{
  "name": "fungsiverse-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:simulation-lab": "node --experimental-strip-types tests/simulation-lab-math.test.mjs && node --experimental-strip-types tests/function-expression.test.mjs",
    "test:assessment": "node --experimental-strip-types --test tests/evaluation-selection.test.mjs tests/text-normalization.test.mjs",
    "test:math-rendering": "node --experimental-strip-types --test tests/math-text.test.mjs",
    "audit:assessment": "node --env-file=.env.local scripts/audit-assessment-bank.mjs",
    "fix:axis-terms": "node --env-file=.env.local scripts/normalize-axis-terms.mjs --normalize-files --apply",
    "db:build-seed": "node scripts/build-neon-question-seed.mjs && node scripts/build-neon-example-seed.mjs",
    "db:apply-neon": "node scripts/apply-neon-schema.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^16.0.3",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
