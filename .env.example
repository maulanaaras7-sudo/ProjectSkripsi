# Gunakan pooled connection string dari Neon untuk Vercel/serverless.
# Salin nilainya dari Neon: Connect > Connection string > Pooled connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Minimal 32 karakter acak. Contoh pembuatan: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
